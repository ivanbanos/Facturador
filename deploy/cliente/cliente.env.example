# =====================================================================================
#  Configuración de UN cliente. La forma fácil de crearla es:  deploy/scripts/nuevo-cliente.sh
#  Manual: copiar a deploy/clientes/<cliente>.env y llenar. Ese archivo NO se versiona.
#  Las líneas marcadas (obligatorio) no pueden quedar vacías; validar con scripts/validar-env.sh
# =====================================================================================

# ----------------------------------- IDENTIDAD -----------------------------------
# (obligatorio) Identificador corto: minúsculas, números y guiones. Se usa en subdominios y contenedores.
CLIENTE=cootranshuila
# (obligatorio) Nombre del cliente en los datos (base Mongo, reglas especiales). Respeta mayúsculas.
# Para clientes existentes use el valor que tenía RepositorioConfig:Cliente en appsettings.json.
CLIENTE_DATOS=cootranshuila
# (obligatorio) Dominio base. Web: https://<CLIENTE>.<DOMINIO_BASE>  API: https://<CLIENTE>.api.<DOMINIO_BASE>
DOMINIO_BASE=sigesmas.com
# Versión de las imágenes a desplegar (tag). "latest" = la última construida.
VERSION=latest
# Registro de imágenes, con "/" final. Vacío = imágenes construidas en el mismo servidor.
REGISTRO=

# --------------------------------- BASE DE DATOS ---------------------------------
# Nombre de la base SQL del cliente
SQL_DATABASE=cootranshuila
# Login SQL propio del cliente (lo crea desplegar.sh; solo tiene permisos sobre su base)
SQL_USER=app_cootranshuila
# (obligatorio) Contraseña del login SQL. nuevo-cliente.sh la genera.
SQL_PASSWORD=
# Servidor SQL. "sqlserver" = el contenedor compartido.
SQL_HOST=sqlserver

# Usuario Mongo propio del cliente (lo crea desplegar.sh)
MONGO_USER=app_cootranshuila
# (obligatorio) Contraseña Mongo. nuevo-cliente.sh la genera.
MONGO_PASSWORD=

# ----------------------------------- SEGURIDAD -----------------------------------
# (obligatorio) Secreto para firmar los tokens de sesión (JWT). Mínimo 32 caracteres. nuevo-cliente.sh lo genera.
# Cambiarlo cierra todas las sesiones abiertas.
JWT_SECRET=

# --------------------------- FACTURACIÓN ELECTRÓNICA -----------------------------
# (obligatorio) Proveedor: DATAICO | SIIGO | ALEGRA | SILOG | SILOG2 | TITAN | FACTURA1 | CELESTE
FE_PROVEEDOR=DATAICO
FE_URL=https://api.dataico.com/direct/dataico_api/v2/
# Credenciales del proveedor (según proveedor: token/cuenta o usuario/contraseña)
FE_TOKEN=
FE_ACCOUNT_ID=
FE_CORREO=
FE_USUARIO=
FE_CONTRASENA=
FE_NIT=
# Resolución DIAN
FE_RESOLUCION=
FE_PREFIJO=
# Códigos de producto en el proveedor
FE_COD_CORRIENTE=
FE_COD_ACPM=
FE_COD_EXTRA=
FE_COD_GAS=
# Opciones (true/false)
FE_ENVIO_DIRECTO=true
FE_ENVIA_CREDITOS=false
FE_ENVIA_MES=false
FE_VALIDA_TERCERO=false
FE_MULTIPLICAR_POR_DIEZ=false

# ----------------------------------- FRONTEND ------------------------------------
# Funcionalidades opcionales (objeto JSON en una línea, entre comillas simples)
FEATURE_FLAGS='{"usuarios-clientes": true}'
# URL del API vista desde el navegador. Vacío = https://<CLIENTE>.api.<DOMINIO_BASE>/api
API_URL=
# Dominios adicionales para la web, separados por espacio (ej. facturacion.cliente.com). Deben apuntar al servidor.
SUBDOMINIOS_EXTRA=

# ------------------------------------ WORKER -------------------------------------
# true = levantar el worker de facturación para este cliente
WORKER_HABILITADO=true

# ----------------------------------- AVANZADO ------------------------------------
# Archivo JSON (formato appsettings) para opciones que no caben en variables:
# Alegra:Estaciones, Alegra:FormasPago, Alegra:ServerTimeOffsetHours, Alegra:Current, Syscafe, etc.
# Ruta relativa a deploy/cliente/. Ej: ../clientes/cootranshuila.appsettings.json
CONFIG_AVANZADA=
# Límites de memoria
API_MEMORIA=768m
WORKER_MEMORIA=512m
