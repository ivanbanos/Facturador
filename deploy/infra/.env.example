# Copiar a deploy/infra/.env y llenar. Este archivo NO se versiona.

# Correo para los certificados HTTPS de Let's Encrypt (avisos de vencimiento)
ACME_EMAIL=

# Contraseña del usuario "sa" de SQL Server.
# Mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos (requisito de SQL Server).
SA_PASSWORD=

# Edición de SQL Server: Express (gratis, 10 GB por base) | Standard | Enterprise
MSSQL_PID=Express

# Usuario administrador de MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=

# Puertos de administración (solo 127.0.0.1, para túnel SSH). Cambiar si ya están ocupados en el equipo.
SQL_PUERTO_ADMIN=1433
MONGO_PUERTO_ADMIN=27017
